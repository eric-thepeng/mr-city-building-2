  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">MarsMain – Mars Homecoming sandbox</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input SceneObject camera {"hint":"The camera (Camera Object with Device Tracking)"}'
    - '// @input SceneObject board {"hint":"Board: terrain, resources and buildings live here, scaled to 50 cm per game unit"}'
    - '// @input SceneObject modelLibrary {"hint":"Disabled instance of Models/world.glb; buildings and resources are copied from it by node name"}'
    - '// @input AssignableType_1 signUI {"hint":"Budget sign (MarsSignUI)"}'
    - '// @input AssignableType_2 choiceUI {"hint":"Choice panel in the hand row (MarsChoiceUI)"}'
    - '// @input Asset.JsonAsset gameData {"hint":"game-data.json (exported from Unity)"}'
    - '// @input Asset.JsonAsset expansionData {"hint":"expansion.json (hand-made buildings, packs, milestones)"}'
    - '// @input Asset.JsonAsset boardData {"hint":"board.json (heightfield and resource nodes)"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input float boardDistance = 75 {"hint":"Distance from the eyes to the centre of the board, in cm", "widget":"slider", "min":40, "max":150, "step":1}'
    - '// @input float boardBelowEyes = 45 {"hint":"How far below the eyes the board stands, in cm", "widget":"slider", "min":0, "max":100, "step":1}'
    - '// @input bool unlockAllPacks {"hint":"Start with every building pack unlocked (skips the milestones; the WebXR ?unlock)"}'
    - '// @input bool debugColliders {"hint":"Draw the grab / hover colliders"}'
    - '// @input bool startWithChoice {"hint":"Debug: start at the first score milestone (new pack card, then the hand choice) instead of a random first hand"}'
    - '// @input string firstHand {"hint":"Debug: deal this hand preset first (e.g. Skywatch_01); empty = a random hand, as in the WebXR version"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Sounds"}'
    - '// @input Asset.AudioTrackAsset sfxBuild {"hint":"Placed a building / picked a hand"}'
    - "// @input Asset.AudioTrackAsset sfxFail {\"hint\":\"Can't build here / game over\"}"
